{
  "name": "forge-engine",
  "version": "0.1.0",
  "description": "Forge Engine: a web-based 2D/3D game engine with ECS, scripting, physics and multiplayer hooks.",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
